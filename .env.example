# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# --- Postgres ---
POSTGRES_USER=birddog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=birddog
DB_PORT=22543

# --- Service ports ---
API_PORT=22800
WEB_PORT=22300
KEYCLOAK_PORT=22080
MAILPIT_UI_PORT=22025

# --- Local authentication ---
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_DB_NAME=keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=birddog-kc-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
BIRDDOG_ADMIN_USERNAME=birddog
BIRDDOG_ADMIN_EMAIL=ah.ahkami@gmail.com
BIRDDOG_ADMIN_PASSWORD=change-me
BIRDDOG_OIDC_CLIENT_SECRET=change-me
AUTH_SECRET=change-me

# --- Worker schedule ---
SCHEDULE_CRON="0 17 * * *"
TIMEZONE=Europe/Berlin

# --- CV processing ---
CV_MAX_BYTES=26214400
CV_MAX_PAGES=50
CV_OCR_TIMEOUT_SECONDS=120
CV_OCR_DPI=200
CV_WORKER_INTERVAL_SECONDS=2

# --- AI engine: KIConnect (OpenAI-compatible) ---
KI_CONNECT_BASE_URL=https://chat.kiconnect.nrw/api/v1
KI_CONNECT_API_KEY=            # set your key here; do NOT commit it
KI_CONNECT_MODEL=ki.inferenz.nrw-mistralai-mistral-small-4-119b-2603
