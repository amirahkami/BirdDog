# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# --- Postgres ---
POSTGRES_USER=birddog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=birddog
DB_PORT=22543

# --- Service ports ---
API_PORT=22800
WEB_PORT=22300

# --- Self-hosted LLM (OpenWebUI + Ollama) ---
OPENWEBUI_BASE_URL=https://openwebui.futuristic.team
OPENWEBUI_API_KEY=            # set your key here; do NOT commit it
LLM_MODEL=qwen2.5:14b-instruct
EMBEDDING_MODEL=bge-m3
